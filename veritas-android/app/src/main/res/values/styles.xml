<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme used by SplashActivity -->
    <style name="Theme.VeritasSplash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/veritas_primary</item>
        <item name="android:navigationBarColor">@color/veritas_primary</item>
        <item name="android:statusBarColor">@color/veritas_primary</item>
    </style>

    <!-- Fullscreen theme for WebView -->
    <style name="Theme.VeritasFullscreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Settings activity theme -->
    <style name="Theme.VeritasSettings" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/veritas_primary</item>
        <item name="android:navigationBarColor">@color/veritas_primary</item>
        <item name="android:statusBarColor">@color/veritas_primary</item>
    </style>
</resources>